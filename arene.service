# Service systemd utilisateur : relance l'arène si elle s'arrête, et la démarre avec ta session.
# Installation : voir README (section « Démarrage automatique »).
[Unit]
Description=L'Arène des générations
After=network.target

[Service]
WorkingDirectory=%h/arene
ExecStart=%h/arene/target/release/arene %h/arene
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
